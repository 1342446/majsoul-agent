{
  "manifest_version": 3,
  "name": "雀魂牌局观察器 · 核对原型",
  "version": "0.2.0",
  "description": "观察雀魂牌局，支持用户配置大模型进行局面分析。",
  "web_accessible_resources": [
    {
      "resources": [
        "tiles/*.svg"
      ],
      "matches": [
        "https://game.maj-soul.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://game.maj-soul.com/*"
      ],
      "js": [
        "protocol.js",
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://game.maj-soul.com/*"
      ],
      "js": [
        "state.js",
        "history.js",
        "analysis.js",
        "analysis-panel.js",
        "overlay.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
